/**
 * Librarian — architecture as code, v2.
 *
 * V2 is a NAVIGATION model, not a reference model. The rule that shapes it: one
 * question per view, and the answer is a picture you can read in ten seconds.
 * Detail is reached by zooming, never by including.
 *
 * The views that exist today:
 *
 *   index            — helicopter. Who is involved, and what librarian sits between.
 *   librarianInside  — one click down on the binary: what it can do, four boxes.
 *   captureInside    — one click down on Capture: one record, then the irreversible strip.
 *   distillInside    — one click down on Distill: the two writers and the gate chain.
 *   recallInside     — one click down on Recall: one engine, two ways of being asked.
 *   exportInside     — one click down on Export: what leaves, and what it is marked with.
 *
 * Clicking an element navigates into its view — LikeC4 wires that automatically for
 * any element a view is scoped `of`. A capability without a view is one
 * `view of <element>` away, added when a question needs it rather than for symmetry.
 *
 * OUTSIDE THINGS COME BACK AS YOU DESCEND. The helicopter view shows who is involved;
 * `librarianInside` hides all of them, because "which capability" is the only question
 * there; `distillInside` and `recallInside` show the models, the vault, and the callers
 * again, because at that depth what a step calls out to — or is called by — IS the
 * answer. Externals are not clutter or not-clutter in general — they are relevant at
 * exactly one altitude.
 *
 * Deliberately absent (this is what v1 got wrong, not something missing here):
 * decisions, triggers, events, file paths, retention tags. Those are durable facts and
 * they live in ../specs/. The model links to them; it does not mirror them.
 *
 * VIEW IDS ARE AN API — issues deep-link `librarian_v2.html#/view/<id>/`.
 * Add freely, rename never.
 */
specification {

  element actor {
    style {
      shape person
      color secondary
    }
  }

  element system {
    style {
      color secondary
    }
  }

  // One path through librarian. Not a file, not a module — an answer to "what does
  // it do". The code behind each one is a zoom level that does not exist yet.
  element path {
    style {
      shape component
      color primary
    }
  }

  element store {
    style {
      shape storage
      color gray
    }
  }
}

model {

  human = actor 'The human' {
    description '
      Author, curator, and the only authority that can revise, flag, or retire a note.
    '
  }

  agents = system 'Instrumented coding agents' {
    description '
      Claude Code and OpenCode. The only surfaces librarian both reads from and writes
      into — everything else is read-only.
    '
  }

  hosts = system 'Any other MCP host' {
    description '
      Codex, Cursor, ChatGPT. Read-only, and nothing is built per host: a config entry
      spawns the same binary.
    '
  }

  models = system 'Local model runtime' {
    description '
      Completion for distilling, embeddings for search. Swappable, and a fully local
      setup stays possible.
    '
  }

  librarian = system 'Librarian' {
    description '
      A personal context layer that gives any AI assistant the right parts of your
      knowledge, unasked. The product is not memory and not search — it is not having
      to explain the same thing twice.
    '

    capture = path 'Capture' {
      description '
        Watches the sessions you are already having. Secrets and private spans are
        stripped before anything is written down.
      '

      mapped = path 'Whatever the host calls it' {
        description '
          Every agent fires its own hook points with its own payload shape. A thin mapper
          per host turns them into one record — after this point nothing knows, or needs
          to know, which agent it came from.
        '
      }

      redacted = path 'Strip it before it is written' {
        description '
          Secrets, the spans you marked private, your home path. This has to happen here
          and not later: nothing that reaches the log can be taken back out of it, so a
          miss on this side of the line is permanent.
        '
      }

      checked = path 'Is this a real event?' {
        description '
          A shape check, and one refusal it will not soften: a record that came out of
          librarian is never let back in as something that happened. Anything malformed is
          set aside loudly rather than dropped quietly.
        '
      }

      sessionLog = store 'What happened' {
        description '
          Appended to, never rewritten — so a note can always be traced back to the
          session it came from, and a bad judgment can be made again from scratch.
        '
      }
    }

    distill = path 'Distill' {
      description '
        Decides what was worth remembering, and writes it as a note. Nothing is kept
        without that judgment — this is the one door into memory.
      '

      enough = path 'Enough happened?' {
        description '
          A free, local look at the session before anything is paid for: no sign that
          anything was learned, nothing written, barely a conversation — then there is
          nothing to draft, and the model is never called.
        '
      }

      draft = path 'Draft a note, or decline' {
        description '
          One call, and it can come back either way: here is the note, or nothing here
          was worth remembering. Judging worth inside the call already being paid for is
          what makes the cheapest gate free.
        '
      }

      novelty = path 'Already known?' {
        description '
          A search against what is already remembered. Cheap check before an expensive
          one: never pay for a second opinion on a note that is a duplicate.
        '
      }

      faithful = path 'True to what happened?' {
        description '
          A second opinion that can only veto, never edit — a checker allowed to fix a
          note would be a second unchecked writer.
        '
      }

      handwritten = path 'Take it verbatim' {
        description '
          What you wrote by hand skips every gate: you already judged it. Your words are
          kept exactly as you wrote them.
        '
      }
    }

    recall = path 'Recall' {
      description '
        Brings the few notes that matter into whatever you are working in, without being
        asked for them.
      '

      lookup = path 'Two ways of matching' {
        description '
          The same question asked twice: which notes use these words, and which notes
          mean this. Neither way alone is enough — one finds the note you phrased
          differently, the other finds the note whose exact term you forgot.
        '
      }

      ranking = path 'Which few actually matter?' {
        description '
          Arithmetic, never a model opinion: yours outranks borrowed, this project
          outranks the others, recent outranks stale, and a decision never goes stale.
          Whatever lands under the line is dropped rather than used to fill a slot.
        '
      }

      unasked = path 'Hand a few back, unasked' {
        description '
          A handful at most, small enough to go unnoticed, and always marked as maybe
          relevant rather than as instructions. Nothing above the line means nothing is
          sent: when the guess would be wrong, silence is the better answer.
        '
      }

      search = path 'Answer a search' {
        description '
          Someone typed the question on purpose, so the answer can afford to be generous:
          more results, and the follow-ups — read the note, read what it was drawn from —
          are expected rather than avoided.
        '
      }
    }

    export = path 'Export' {
      description '
        Publishes everything as Markdown, so the knowledge stays readable with librarian
        uninstalled.
      '

      sinceLast = path 'What is new since last time?' {
        description '
          Picks up where the last pass stopped, so a run over an unchanged library writes
          nothing at all. Publishing has to be something you can do again at any moment
          without wondering what it will touch.
        '
      }

      winner = path 'What is the note now?' {
        description '
          A note is the last thing said about it. The current version is what gets
          published — and a note you retired has its page taken away, because a copy that
          keeps what you retracted is worse than no copy.
        '
      }

      written = path 'Write it where it stays readable' {
        description '
          Plain Markdown, and every page says on its face that librarian wrote it. That
          mark is what keeps the two halves apart: the vault is also where you write by
          hand, and a generated page must never come back in as something you wrote.
        '
      }
    }
  }

  vault = store 'Obsidian vault' {
    description 'Shared with the human, and never the canonical copy.'

    // The seam. Two halves, one owner each, and nothing crosses — held by
    // construction rather than convention (../specs/structural-invariants.md).
    generated = store 'Librarian wrote this half' {
      description '
        Every page says so on its face. That mark is the whole mechanism: it is what lets
        the other half be read back in without librarian ever re-reading its own output.
      '
    }

    curated = store 'You wrote this half' {
      description '
        Yours, and export never touches it. Not a rule anyone has to remember — the
        exporter has no path that reaches here.
      '
    }
  }

  // Level 1 edges are derived from these — LikeC4 rolls child relations up to the parent.

  agents -> mapped 'session activity'
  agents -> lookup 'whatever it is working on right now'
  unasked -> agents 'notes, spliced in unasked'
  hosts -> lookup 'search, read-only'
  search -> hosts 'results, and room to follow up'
  human -> librarian 'the CLI when something needs fixing'

  distill -> sinceLast 'notes, as they were written'

  mapped -> redacted 'one record, whatever fired it'
  redacted -> checked 'nothing secret left in it'
  checked -> sessionLog 'appended, never rewritten'
  sessionLog -> enough 'what happened, already redacted'

  enough -> draft 'enough signal to be worth a call'
  draft -> models 'one call: a note, or nothing here'
  draft -> novelty 'a note it says is worth keeping'
  novelty -> faithful 'new'
  faithful -> models 'is this true to what happened?'
  faithful -> recall 'kept — and now findable'
  handwritten -> recall 'kept as written'

  lookup -> models 'embed the question'
  lookup -> ranking 'everything either way of matching turned up'
  ranking -> unasked 'the few above the line'
  ranking -> search 'the best matches'

  sinceLast -> winner 'the notes that changed'
  winner -> written 'the version that survived'
  winner -> generated 'retired — its page is taken away'
  written -> generated 'a Markdown page, marked as generated'
  human -> curated 'writes notes by hand'
  curated -> handwritten 'markdown you wrote'
}

views {

  view index {
    title 'Librarian — context'
    description '
      Start here, then pick where to look. Librarian sits between the tools you already
      work in and the knowledge you would otherwise re-explain. Click Librarian to go
      one level in.
    '
    autoLayout LeftRight

    include human, agents, hosts, models, librarian, vault

    // Distill and recall both call out; at this altitude that is one arrow, not two.
    include librarian -> models with {
      title 'writes notes, embeds queries'
    }

    // An agent is read from and written back into; at this altitude the reading is one
    // arrow, whether librarian is listening or answering.
    include agents -> librarian with {
      title 'session activity'
    }

    // A read-only host asks and is answered — one interaction, so one arrow. The
    // answer coming back only becomes a thing of its own inside Recall.
    exclude librarian -> hosts
  }

  view librarianInside of librarian {
    title 'Librarian — inside'
    description '
      What librarian can do, and nothing else. No stores, no plumbing, and nothing from
      outside the binary — who calls a capability and what it calls out to only becomes
      interesting one level further down, so it stays hidden until then. Knowledge goes
      one way: captured, judged, then handed back or published.
    '
    autoLayout TopBottom

    // `include *` is one level only, so Distill's own steps stay behind its box —
    // and their relations still roll up into the arrows drawn here.
    include *
    exclude human, agents, hosts, models, vault

    // Both of Distill's exits land in Recall; at this altitude that is one arrow.
    include distill -> recall with {
      title 'notes, now findable'
    }
  }

  view captureInside of capture {
    title 'Capture — nothing is polled, and secrets never land'
    description '
      The agents do the noticing: each one fires its own hook points, and a mapper per host
      is all it takes to make them one record. Then the only irreversible step in librarian
      — strip the secrets, the private spans, the home path — because what reaches the log
      stays there. What survives is what happened, appended and never rewritten, so any note
      can be traced back to it and any judgment can be made again.
    '
    autoLayout TopBottom

    include *, agents, distill
  }

  view distillInside of distill {
    title 'Distill — the one door into memory'
    description '
      Two ways in, and only one of them is negotiable. The questions are asked cheapest
      first: was there any signal at all (free, local), is there a note in it and is that
      note worth keeping (one call, both answers), is it already known (a search), is it
      true to what happened (a second call). Any no means it is simply not kept. What you
      wrote by hand walks past all of them, because you already made the judgment they
      exist to make.
    '
    autoLayout TopBottom

    include *, capture, recall, models, vault

    // Recall calls the models too; that is recall's business, not this view's.
    exclude recall -> models
  }

  view recallInside of recall {
    title 'Recall — one engine, two ways of being asked'
    description '
      Nobody asks for the left-hand path and everybody asks for the right-hand one, and
      that single difference decides how much is allowed back. The middle is shared: match
      twice, because words and meaning each find notes the other misses, then rank in plain
      arithmetic and draw a line. Uninvited, only a handful crosses it and an empty answer
      is a fine answer. Asked outright, the same list can afford to be generous.
    '
    autoLayout TopBottom

    include *, agents, hosts, models
  }

  view exportInside of export {
    title 'Export — the copy that outlives librarian'
    description '
      Publishing is something you can do again at any moment: it resumes where it stopped,
      so an unchanged library writes nothing. What goes out is the note as it stands now,
      and a note you retired loses its page — a copy that keeps what you retracted is worse
      than no copy. Then the seam: the vault is shared, so it is halved. Export can only
      reach its own half, and marks every page it leaves there. What you wrote by hand sits
      in the other half, which export has no path to at all.
    '
    autoLayout TopBottom

    include *, distill, vault, vault.*

    // The curated half is also what the human distiller reads — true, and not this
    // view's question. Drawn here it reads as export feeding back into distill, which
    // is the one thing the seam exists to prevent.
    exclude curated -> distill
  }
}
