{
  "name": "librarian",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "librarian": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc",
    "build:binary": "bash scripts/build-sea.sh",
    "test": "node --import ./tests/setup-home.ts --test \"tests/**/*.test.ts\"",
    "test:binary": "LIBRARIAN_BINARY_TEST=1 node --import ./tests/setup-home.ts --test tests/cli/update.binary.test.ts",
    "qualify": "node --import ./tests/setup-home.ts --test tests/distill/providerQualification.test.ts",
    "lint": "eslint src",
    "arch": "likec4 validate docs/architecture",
    "arch:dev": "likec4 start docs/architecture",
    "arch:build": "likec4 build -o build/architecture docs/architecture",
    "arch:single": "likec4 build --output-single-file --use-hash-history -t Librarian -o build/arch-single docs/architecture && cp build/arch-single/index.html docs/architecture/librarian.html"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "likec4": "1.59.2",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5",
    "typescript-eslint": "^8.64.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "sqlite-vec": "0.1.9",
    "ulid": "^3.0.2"
  }
}
